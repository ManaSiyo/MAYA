rules_version = '2';
// MAYA v12.5. One account, many projects, nothing shared, nothing local.
// Deleted means deleted: a tombstone blocks the project ever being written
// again, but it must never block the delete itself.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // v12.5: the legacy shared session store is now READ ONLY. The one time
      // rescue pass copies anything still in here across into real projects.
      // Nothing writes here again, so an old tab or an old deployment can no
      // longer resurrect a project that was moved or deleted.
      match /sessions/{sessionId} {
        allow read:  if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /favorites/{favId} {           // legacy favorites, read only for the same reason
        allow read:  if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      match /projects/{projectId} {        // v12 projects, the only writable store
        allow read: if request.auth != null && request.auth.uid == uid;
        // v12.5: create and update are blocked once a tombstone exists, but
        // DELETE is always allowed. The old rule lumped delete in with write,
        // so deleting a project was denied the instant its tombstone was
        // written, and the project stayed alive while the screen said it was
        // gone everywhere.
        allow create, update: if request.auth != null && request.auth.uid == uid
          && !exists(/databases/$(database)/documents/users/$(uid)/projectTombstones/$(projectId));
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
      match /projectTombstones/{projectId} {
        allow read, create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;    // permanent, the dead stay dead
      }
      match /settings/{docId} {            // project index, migration flag, per account drafts
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // v13.3 THE COMMUNITY WALL. One flat public collection: every signed in
    // account reads it, but a post can only be created by the account whose
    // uid is in it, and only that account (or the atelier) can take it down.
    // A post is never editable, so nobody can swap the picture under a
    // document somebody else is looking at.
    match /community/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() < 2000
        && request.resource.data.author is string
        && request.resource.data.author.size() < 60
        && request.resource.data.summary is string
        && request.resource.data.summary.size() < 400;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || request.auth.token.email in ['fromsa@manasiyo.com', 'worldofsiyo@gmail.com', 'prasheeth@step-6.com']);
    }

    // v13.7 SHARED PROJECTS. A share is a frozen snapshot of one project
    // under a random token. Anyone signed in with the link reads it; only
    // the owner creates or takes it down; a share is never editable, so the
    // project someone is looking at cannot be swapped underneath them.
    match /shares/{token} {
      // v13.12 SECURITY: GET only for the world. LIST was open before, so any
      // signed in account could enumerate every share in existence instead of
      // needing the unguessable token. Owners can still list their own.
      allow get: if request.auth != null;
      allow list: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() < 100
        && request.resource.data.pid is string
        && request.resource.data.pid.size() < 80;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // v12.4 prompting engine, the shared words MAYA draws with. Every signed in
    // client reads these because their renders are built from them; only the
    // atelier can change them.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email in ['fromsa@manasiyo.com', 'worldofsiyo@gmail.com', 'prasheeth@step-6.com'];
    }
  }
}
