rules_version = '2';
// MAYA v12.5. One account, many projects, nothing shared, nothing local.
// Deleted means deleted: a tombstone blocks the project ever being written
// again, but it must never block the delete itself.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // v12.5: the legacy shared session store is now READ ONLY. The one time
      // rescue pass copies anything still in here across into real projects.
      // Nothing writes here again, so an old tab or an old deployment can no
      // longer resurrect a project that was moved or deleted.
      match /sessions/{sessionId} {
        allow read:  if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /favorites/{favId} {           // legacy favorites, read only for the same reason
        allow read:  if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      match /projects/{projectId} {        // v12 projects, the only writable store
        allow read: if request.auth != null && request.auth.uid == uid;
        // v12.5: create and update are blocked once a tombstone exists, but
        // DELETE is always allowed. The old rule lumped delete in with write,
        // so deleting a project was denied the instant its tombstone was
        // written, and the project stayed alive while the screen said it was
        // gone everywhere.
        allow create, update: if request.auth != null && request.auth.uid == uid
          && !exists(/databases/$(database)/documents/users/$(uid)/projectTombstones/$(projectId));
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
      match /projectTombstones/{projectId} {
        allow read, create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;    // permanent, the dead stay dead
      }
      match /settings/{docId} {            // project index, migration flag, per account drafts
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // v12.4 prompting engine, the shared words MAYA draws with. Every signed in
    // client reads these because their renders are built from them; only the
    // atelier can change them.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email in ['fromsa@manasiyo.com', 'worldofsiyo@gmail.com'];
    }
  }
}
